<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <DefineConstants>UNITY_ANDROID;UNITY_5_3_OR_NEWER</DefineConstants>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>0618;0672;CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Platform/PhysicalMouseDeltaAccumulator.cs" />
    <Compile Include="../../Runtime/Platform/AndroidPhysicalMouseCapture.cs" />
    <Compile Include="../../Runtime/Platform/AndroidRuntimeLog.cs" />
    <Compile Include="../../Runtime/Platform/PersistentDiagnosticLog.cs" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(OriginalManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(OriginalManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AndroidJNIModule">
      <HintPath>$(OriginalManagedDir)/UnityEngine.AndroidJNIModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(OriginalManagedDir)/Unity.InputSystem.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
