{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raft mini lab testpack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker",
    "pack_id",
    "title",
    "version",
    "source_sha",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "worker": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ]
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source_sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "instructions",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "type": {
            "enum": [
              "note",
              "mouse",
              "file_sha256",
              "image_preview"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "asset": {
            "type": "string",
            "maxLength": 180
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
